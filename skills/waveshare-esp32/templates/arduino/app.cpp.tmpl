// {{NAME}} - starter sketch for {{BOARD_NAME}}
// Prints chip/memory info, turns on the backlight and blinks the RGB LED if the board has them.
#include <Arduino.h>
#include "board_pins.h"

void setup() {
  Serial.begin(115200);
  delay(1500);  // give native-USB serial time to enumerate

  Serial.printf("Board: %s (%s)\n", WS_BOARD_NAME, WS_BOARD_SOC);
  Serial.printf("Chip: %s rev %d, %d cores\n", ESP.getChipModel(), ESP.getChipRevision(), ESP.getChipCores());
  Serial.printf("Flash: %u MB\n", (unsigned)(ESP.getFlashChipSize() / (1024 * 1024)));
  Serial.printf("PSRAM: %u KB (board has %d MB)\n", (unsigned)(ESP.getPsramSize() / 1024), WS_PSRAM_MB);
  if (WS_PSRAM_MB > 0 && ESP.getPsramSize() == 0) {
    Serial.println("PSRAM not detected: check the PSRAM option in your board settings.");
  }

#ifdef WS_LCD_BL
  pinMode(WS_LCD_BL, OUTPUT);
  digitalWrite(WS_LCD_BL, HIGH);
#endif
}

void loop() {
#ifdef WS_RGB_LED_DATA
  static uint8_t step = 0;
  const uint8_t c[3][3] = {{20, 0, 0}, {0, 20, 0}, {0, 0, 20}};
#if ESP_ARDUINO_VERSION_MAJOR >= 3
  rgbLedWrite(WS_RGB_LED_DATA, c[step][0], c[step][1], c[step][2]);
#else
  neopixelWrite(WS_RGB_LED_DATA, c[step][0], c[step][1], c[step][2]);
#endif
  step = (step + 1) % 3;
#endif
  Serial.printf("alive, free heap: %u\n", (unsigned)ESP.getFreeHeap());
  delay(1000);
}

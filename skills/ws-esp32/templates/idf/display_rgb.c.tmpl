/*
 * display.c - RGB LCD{{TOUCH_TITLE}} + LVGL bring-up for {{BOARD_NAME}}
 * Generated by the ws-esp32 skill. Stack: esp_lcd RGB panel -> esp_lvgl_port -> LVGL 9.
 *
 * Timings and the CH422G expander sequence follow Waveshare's demo:
 *   {{TIMING_SOURCE}}
 * The CH422G is not a normal I2C device: each I2C address is a register
 * (0x24 = mode, 0x38 = output pins EXIO0-7).
 */
#include "display.h"

#include "board_pins.h"
#include "driver/gpio.h"
#include "driver/i2c_master.h"
#include "esp_check.h"
#include "esp_idf_version.h"
#include "esp_lcd_panel_ops.h"
#include "esp_lcd_panel_rgb.h"
#include "esp_log.h"
#include "esp_lvgl_port.h"
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"

#define LCD_HAS_TOUCH {{HAS_TOUCH}}
#if LCD_HAS_TOUCH
#include "esp_lcd_touch_gt911.h"
#endif

#define CH422G_ADDR_MODE   0x24
#define CH422G_ADDR_OUTPUT 0x38
#define CH422G_MODE_OUTPUT 0x01

/* Output byte: bit n = EXIOn. */
#define EXIO_BIT(n) (1u << (n))
#define EXIO_OUT_BASE (EXIO_BIT(WS_LCD_BL_EXIO) | EXIO_BIT(WS_LCD_RST_EXIO) | {{EXIO_EXTRA}})

static const char *TAG = "display";
static i2c_master_bus_handle_t s_i2c;
static i2c_master_dev_handle_t s_exio_mode, s_exio_out;

static esp_err_t exio_write(uint8_t value)
{
    return i2c_master_transmit(s_exio_out, &value, 1, 100);
}

static esp_err_t expander_init(void)
{
    i2c_master_bus_config_t bus_cfg = {
        .i2c_port = I2C_NUM_0,
        .sda_io_num = WS_I2C_SDA,
        .scl_io_num = WS_I2C_SCL,
        .clk_source = I2C_CLK_SRC_DEFAULT,
        .glitch_ignore_cnt = 7,
        .flags.enable_internal_pullup = true,
    };
    ESP_RETURN_ON_ERROR(i2c_new_master_bus(&bus_cfg, &s_i2c), TAG, "I2C bus");

    i2c_device_config_t dev = {.dev_addr_length = I2C_ADDR_BIT_LEN_7, .scl_speed_hz = 400 * 1000};
    dev.device_address = CH422G_ADDR_MODE;
    ESP_RETURN_ON_ERROR(i2c_master_bus_add_device(s_i2c, &dev, &s_exio_mode), TAG, "CH422G mode");
    dev.device_address = CH422G_ADDR_OUTPUT;
    ESP_RETURN_ON_ERROR(i2c_master_bus_add_device(s_i2c, &dev, &s_exio_out), TAG, "CH422G out");

    uint8_t mode = CH422G_MODE_OUTPUT;
    ESP_RETURN_ON_ERROR(i2c_master_transmit(s_exio_mode, &mode, 1, 100), TAG, "CH422G set mode");
    /* Backlight on, LCD out of reset, touch held in reset. */
    return exio_write(EXIO_OUT_BASE);
}

#if LCD_HAS_TOUCH
static esp_err_t touch_init(esp_lcd_touch_handle_t *out)
{
    /* GT911 picks I2C address 0x5D when INT is low while it leaves reset. */
    gpio_config_t int_cfg = {.pin_bit_mask = 1ULL << WS_TOUCH_INT, .mode = GPIO_MODE_OUTPUT};
    ESP_RETURN_ON_ERROR(gpio_config(&int_cfg), TAG, "touch INT");
    gpio_set_level(WS_TOUCH_INT, 0);
    vTaskDelay(pdMS_TO_TICKS(100));
    ESP_RETURN_ON_ERROR(exio_write(EXIO_OUT_BASE | EXIO_BIT(WS_TOUCH_RST_EXIO)), TAG, "touch reset");
    vTaskDelay(pdMS_TO_TICKS(200));

    esp_lcd_panel_io_handle_t io;
    esp_lcd_panel_io_i2c_config_t io_cfg = ESP_LCD_TOUCH_IO_I2C_GT911_CONFIG();
    io_cfg.scl_speed_hz = 400 * 1000;
    ESP_RETURN_ON_ERROR(esp_lcd_new_panel_io_i2c(s_i2c, &io_cfg, &io), TAG, "touch IO");

    esp_lcd_touch_config_t cfg = {
        .x_max = WS_LCD_H_RES,
        .y_max = WS_LCD_V_RES,
        .rst_gpio_num = -1, /* reset is on the expander, handled above */
        .int_gpio_num = -1, /* polled */
        .levels = {.reset = 0, .interrupt = 0},
    };
    return esp_lcd_touch_new_i2c_gt911(io, &cfg, out);
}

static void on_tap(lv_event_t *e)
{
    static int taps;
    lv_label_set_text_fmt(lv_event_get_user_data(e), "Taps: %d", ++taps);
}
#endif

esp_err_t display_start(void)
{
    ESP_RETURN_ON_ERROR(expander_init(), TAG, "IO expander");

    esp_lcd_rgb_panel_config_t cfg = {
        .clk_src = LCD_CLK_SRC_DEFAULT,
        .timings = {
            .pclk_hz = {{PCLK_HZ}},
            .h_res = WS_LCD_H_RES,
            .v_res = WS_LCD_V_RES,
            .hsync_pulse_width = {{HPW}},
            .hsync_back_porch = {{HBP}},
            .hsync_front_porch = {{HFP}},
            .vsync_pulse_width = {{VPW}},
            .vsync_back_porch = {{VBP}},
            .vsync_front_porch = {{VFP}},
            .flags.pclk_active_neg = {{PCLK_NEG}},
        },
        .data_width = 16,
        .bits_per_pixel = 16,
        .num_fbs = 2,
        .bounce_buffer_size_px = WS_LCD_H_RES * {{BOUNCE_LINES}},
#if ESP_IDF_VERSION >= ESP_IDF_VERSION_VAL(5, 4, 0)
        .dma_burst_size = 64,
#else
        .psram_trans_align = 64,
#endif
        .hsync_gpio_num = WS_LCD_HSYNC,
        .vsync_gpio_num = WS_LCD_VSYNC,
        .de_gpio_num = WS_LCD_DE,
        .pclk_gpio_num = WS_LCD_PCLK,
        .disp_gpio_num = -1,
        .data_gpio_nums = { {{DATA_PINS}} },
        .flags.fb_in_psram = 1,
    };
    esp_lcd_panel_handle_t panel;
    ESP_RETURN_ON_ERROR(esp_lcd_new_rgb_panel(&cfg, &panel), TAG, "RGB panel");
    ESP_RETURN_ON_ERROR(esp_lcd_panel_reset(panel), TAG, "reset");
    ESP_RETURN_ON_ERROR(esp_lcd_panel_init(panel), TAG, "init");

    const lvgl_port_cfg_t lvgl_cfg = ESP_LVGL_PORT_INIT_CONFIG();
    ESP_RETURN_ON_ERROR(lvgl_port_init(&lvgl_cfg), TAG, "LVGL port");

    const lvgl_port_display_cfg_t disp_cfg = {
        .panel_handle = panel,
        .buffer_size = WS_LCD_H_RES * 50,
        .double_buffer = true,
        .hres = WS_LCD_H_RES,
        .vres = WS_LCD_V_RES,
        .color_format = LV_COLOR_FORMAT_RGB565,
        .flags = {.buff_spiram = true},
    };
    const lvgl_port_display_rgb_cfg_t rgb_cfg = {.flags = {.bb_mode = true}};
    lv_display_t *disp = lvgl_port_add_disp_rgb(&disp_cfg, &rgb_cfg);
    ESP_RETURN_ON_FALSE(disp, ESP_FAIL, TAG, "add display");

#if LCD_HAS_TOUCH
    esp_lcd_touch_handle_t tp = NULL;
    if (touch_init(&tp) == ESP_OK) {
        const lvgl_port_touch_cfg_t touch_cfg = {.disp = disp, .handle = tp};
        lvgl_port_add_touch(&touch_cfg);
    } else {
        ESP_LOGW(TAG, "Touch init failed; continuing without touch");
    }
#endif

    lvgl_port_lock(0);
    lv_obj_t *scr = lv_screen_active();
    lv_obj_t *title = lv_label_create(scr);
    lv_label_set_text(title, WS_BOARD_NAME);
    lv_obj_align(title, LV_ALIGN_CENTER, 0, -40);
#if LCD_HAS_TOUCH
    lv_obj_t *btn = lv_button_create(scr);
    lv_obj_set_size(btn, 200, 80);
    lv_obj_align(btn, LV_ALIGN_CENTER, 0, 40);
    lv_obj_t *btn_label = lv_label_create(btn);
    lv_label_set_text(btn_label, "Tap me");
    lv_obj_center(btn_label);
    lv_obj_add_event_cb(btn, on_tap, LV_EVENT_CLICKED, btn_label);
#endif
    lvgl_port_unlock();

    ESP_LOGI(TAG, "Display ready: %dx%d", WS_LCD_H_RES, WS_LCD_V_RES);
    return ESP_OK;
}

/*
 * display.c - LCD{{TOUCH_TITLE}} + LVGL bring-up for {{BOARD_NAME}}
 * Generated by the ws-esp32 skill. Stack: esp_lcd -> {{PANEL_PART}} driver -> esp_lvgl_port -> LVGL 9.
 *
 * Panel settings below come from: {{INIT_SOURCE}}
 * Verified on hardware: {{INIT_VERIFIED}}. If the picture is wrong, adjust these first:
 *   colors inverted -> LCD_INVERT    red/blue swapped -> LCD_RGB_ORDER
 *   image shifted   -> LCD_GAP_X/Y   mirrored/rotated -> LCD_MIRROR_X/Y, LCD_SWAP_XY
 */
#include "display.h"

#include "board_pins.h"
#include "driver/gpio.h"
#include "driver/spi_master.h"
#include "esp_check.h"
#include "esp_lcd_panel_io.h"
#include "esp_lcd_panel_ops.h"
#include "esp_lcd_panel_vendor.h"
#include "esp_log.h"
#include "esp_lvgl_port.h"
{{PANEL_INCLUDE}}
#define LCD_HAS_TOUCH   {{HAS_TOUCH}}
#if LCD_HAS_TOUCH
#include "driver/i2c_master.h"
{{TOUCH_INCLUDE}}
#endif

#define LCD_HOST        SPI2_HOST
#define LCD_PCLK_HZ     ({{PCLK_MHZ}} * 1000 * 1000)
#define LCD_RGB_ORDER   {{RGB_ORDER}}
#define LCD_INVERT      {{INVERT}}
#define LCD_GAP_X       {{GAP_X}}
#define LCD_GAP_Y       {{GAP_Y}}
#define LCD_SWAP_XY     {{SWAP_XY}}
#define LCD_MIRROR_X    {{MIRROR_X}}
#define LCD_MIRROR_Y    {{MIRROR_Y}}
#define LCD_DRAW_LINES  40 /* LVGL draw buffer height, in lines */

#ifndef WS_LCD_RST
#define WS_LCD_RST (-1)
#endif

static const char *TAG = "display";

#if LCD_HAS_TOUCH
#ifndef WS_TOUCH_RST
#define WS_TOUCH_RST (-1)
#endif
#ifndef WS_TOUCH_INT
#define WS_TOUCH_INT (-1)
#endif

static esp_err_t touch_init(esp_lcd_touch_handle_t *out)
{
    i2c_master_bus_config_t bus_cfg = {
        .i2c_port = I2C_NUM_0,
        .sda_io_num = WS_I2C_SDA,
        .scl_io_num = WS_I2C_SCL,
        .clk_source = I2C_CLK_SRC_DEFAULT,
        .glitch_ignore_cnt = 7,
        .flags.enable_internal_pullup = true,
    };
    i2c_master_bus_handle_t bus;
    ESP_RETURN_ON_ERROR(i2c_new_master_bus(&bus_cfg, &bus), TAG, "I2C bus");

    esp_lcd_panel_io_handle_t io;
    esp_lcd_panel_io_i2c_config_t io_cfg = {{TOUCH_IO_CONFIG}};
    io_cfg.scl_speed_hz = 400 * 1000;
    ESP_RETURN_ON_ERROR(esp_lcd_new_panel_io_i2c(bus, &io_cfg, &io), TAG, "touch IO");

    esp_lcd_touch_config_t cfg = {
        .x_max = WS_LCD_H_RES,
        .y_max = WS_LCD_V_RES,
        .rst_gpio_num = WS_TOUCH_RST,
        .int_gpio_num = WS_TOUCH_INT,
        .levels = {.reset = 0, .interrupt = 0},
        .flags = {.swap_xy = LCD_SWAP_XY, .mirror_x = LCD_MIRROR_X, .mirror_y = LCD_MIRROR_Y},
    };
    return {{TOUCH_NEW}}(io, &cfg, out);
}

static void on_tap(lv_event_t *e)
{
    static int taps;
    lv_label_set_text_fmt(lv_event_get_user_data(e), "Taps: %d", ++taps);
}
#endif

esp_err_t display_start(void)
{
    /* 1. SPI bus */
    spi_bus_config_t bus = {
        .sclk_io_num = WS_SPI_SCLK,
        .mosi_io_num = WS_SPI_MOSI,
#ifdef WS_SPI_MISO
        .miso_io_num = WS_SPI_MISO, /* shared with other SPI devices on this board */
#else
        .miso_io_num = -1,
#endif
        .quadwp_io_num = -1,
        .quadhd_io_num = -1,
        .max_transfer_sz = WS_LCD_H_RES * LCD_DRAW_LINES * sizeof(uint16_t),
    };
    ESP_RETURN_ON_ERROR(spi_bus_initialize(LCD_HOST, &bus, SPI_DMA_CH_AUTO), TAG, "SPI bus");

    /* 2. Panel IO + driver */
    esp_lcd_panel_io_handle_t io;
    esp_lcd_panel_io_spi_config_t io_cfg = {
        .dc_gpio_num = WS_LCD_DC,
        .cs_gpio_num = WS_LCD_CS,
        .pclk_hz = LCD_PCLK_HZ,
        .lcd_cmd_bits = 8,
        .lcd_param_bits = 8,
        .spi_mode = 0,
        .trans_queue_depth = 10,
    };
    ESP_RETURN_ON_ERROR(esp_lcd_new_panel_io_spi((esp_lcd_spi_bus_handle_t)LCD_HOST, &io_cfg, &io), TAG, "panel IO");

    esp_lcd_panel_dev_config_t panel_cfg = {
        .reset_gpio_num = WS_LCD_RST,
        .rgb_ele_order = LCD_RGB_ORDER,
        .bits_per_pixel = 16,
    };
    esp_lcd_panel_handle_t panel;
    ESP_RETURN_ON_ERROR({{PANEL_NEW}}(io, &panel_cfg, &panel), TAG, "panel driver");
    ESP_RETURN_ON_ERROR(esp_lcd_panel_reset(panel), TAG, "reset");
    ESP_RETURN_ON_ERROR(esp_lcd_panel_init(panel), TAG, "init");
    ESP_RETURN_ON_ERROR(esp_lcd_panel_invert_color(panel, LCD_INVERT), TAG, "invert");
    ESP_RETURN_ON_ERROR(esp_lcd_panel_set_gap(panel, LCD_GAP_X, LCD_GAP_Y), TAG, "gap");
    ESP_RETURN_ON_ERROR(esp_lcd_panel_swap_xy(panel, LCD_SWAP_XY), TAG, "swap");
    ESP_RETURN_ON_ERROR(esp_lcd_panel_mirror(panel, LCD_MIRROR_X, LCD_MIRROR_Y), TAG, "mirror");
    ESP_RETURN_ON_ERROR(esp_lcd_panel_disp_on_off(panel, true), TAG, "display on");

    /* 3. LVGL */
    const lvgl_port_cfg_t lvgl_cfg = ESP_LVGL_PORT_INIT_CONFIG();
    ESP_RETURN_ON_ERROR(lvgl_port_init(&lvgl_cfg), TAG, "LVGL port");

    const lvgl_port_display_cfg_t disp_cfg = {
        .io_handle = io,
        .panel_handle = panel,
        .buffer_size = WS_LCD_H_RES * LCD_DRAW_LINES,
        .double_buffer = true,
        .hres = WS_LCD_H_RES,
        .vres = WS_LCD_V_RES,
        .color_format = LV_COLOR_FORMAT_RGB565,
        .rotation = {.swap_xy = LCD_SWAP_XY, .mirror_x = LCD_MIRROR_X, .mirror_y = LCD_MIRROR_Y},
        .flags = {.buff_dma = true, .swap_bytes = true},
    };
    lv_display_t *disp = lvgl_port_add_disp(&disp_cfg);
    ESP_RETURN_ON_FALSE(disp, ESP_FAIL, TAG, "add display");

#if LCD_HAS_TOUCH
    esp_lcd_touch_handle_t tp = NULL;
    if (touch_init(&tp) == ESP_OK) {
        const lvgl_port_touch_cfg_t touch_cfg = {.disp = disp, .handle = tp};
        lvgl_port_add_touch(&touch_cfg);
    } else {
        ESP_LOGW(TAG, "Touch init failed; continuing without touch");
    }
#endif

    /* 4. Backlight on after the panel has valid content */
#ifdef WS_LCD_BL
    gpio_config_t bl = {.pin_bit_mask = 1ULL << WS_LCD_BL, .mode = GPIO_MODE_OUTPUT};
    ESP_RETURN_ON_ERROR(gpio_config(&bl), TAG, "backlight");
    gpio_set_level(WS_LCD_BL, 1);
#endif

    /* 5. Demo UI. Every LVGL call outside LVGL callbacks must hold the port lock. */
    lvgl_port_lock(0);
    lv_obj_t *scr = lv_screen_active();
    lv_obj_t *title = lv_label_create(scr);
    lv_label_set_text(title, WS_BOARD_NAME);
    lv_obj_align(title, LV_ALIGN_CENTER, 0, -30);
#if LCD_HAS_TOUCH
    lv_obj_t *btn = lv_button_create(scr);
    lv_obj_align(btn, LV_ALIGN_CENTER, 0, 20);
    lv_obj_t *btn_label = lv_label_create(btn);
    lv_label_set_text(btn_label, "Tap me");
    lv_obj_add_event_cb(btn, on_tap, LV_EVENT_CLICKED, btn_label);
#else
    lv_obj_t *hint = lv_label_create(scr);
    lv_label_set_text(hint, "Hello from LVGL");
    lv_obj_align(hint, LV_ALIGN_CENTER, 0, 10);
#endif
    lvgl_port_unlock();

    ESP_LOGI(TAG, "Display ready: %dx%d", WS_LCD_H_RES, WS_LCD_V_RES);
    return ESP_OK;
}

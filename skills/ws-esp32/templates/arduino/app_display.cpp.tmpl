// {{NAME}} - display starter for {{BOARD_NAME}}
// Generated by the ws-esp32 skill. Needs the "GFX Library for Arduino" (Arduino_GFX) library:
//   arduino-cli lib install "GFX Library for Arduino"
// Panel settings come from: {{INIT_SOURCE}} (verified on hardware: {{INIT_VERIFIED}}).
// Colors inverted? Flip the `ips` argument. Image shifted? Change the offsets.
#include <Arduino.h>
#include <Arduino_GFX_Library.h>
#include "board_pins.h"

#ifndef WS_SPI_MISO
#define WS_SPI_MISO GFX_NOT_DEFINED
#endif
#ifndef WS_LCD_RST
#define WS_LCD_RST GFX_NOT_DEFINED
#endif

Arduino_DataBus *bus = new Arduino_ESP32SPI(WS_LCD_DC, WS_LCD_CS, WS_SPI_SCLK, WS_SPI_MOSI, WS_SPI_MISO);
Arduino_GFX *gfx = {{GFX_CTOR}};

void setup() {
  Serial.begin(115200);
  if (!gfx->begin()) {
    Serial.println("gfx->begin() failed");
  }
  gfx->fillScreen(0x0000);
#ifdef WS_LCD_BL
  pinMode(WS_LCD_BL, OUTPUT);
  digitalWrite(WS_LCD_BL, HIGH);
#endif
  gfx->setTextColor(0xFFFF);
  gfx->setTextSize(2);
  gfx->setCursor(10, WS_LCD_V_RES / 2 - 20);
  gfx->println(WS_BOARD_NAME);
}

void loop() {
  static uint32_t n = 0;
  gfx->fillRect(10, WS_LCD_V_RES / 2 + 10, WS_LCD_H_RES - 20, 20, 0x0000);
  gfx->setCursor(10, WS_LCD_V_RES / 2 + 10);
  gfx->setTextColor(0x07E0);  // green
  gfx->printf("uptime %lus", (unsigned long)(n++));
  delay(1000);
}

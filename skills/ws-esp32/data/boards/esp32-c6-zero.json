{
  "$schema": "../board.schema.json",
  "id": "esp32-c6-zero",
  "name": "ESP32-C6-Zero",
  "aliases": [
    "c6 zero",
    "c6 mini"
  ],
  "chip": "esp32c6",
  "soc": "ESP32-C6FH4",
  "flash_mb": 4,
  "psram_mb": 0,
  "psram_mode": "none",
  "usb": {
    "native": true,
    "bridge": null,
    "console": "usb_serial_jtag"
  },
  "verification": {
    "status": "wiki",
    "sources": [
      "https://www.waveshare.com/wiki/ESP32-C6-Zero",
      "https://github.com/waveshareteam/ESP32-C6-Zero-Basic-Kit/blob/main/ESP-IDF/07-Peripheral/rmt_ws2812/main/main.c"
    ],
    "checked": "2026-10-21",
    "notes": "RGB LED GPIO from Waveshare's C6-Zero kit example (BLINK_GPIO 8). BOOT=GPIO9 is the ESP32-C6 default. Header pins are only in the wiki image, so free_pins is not filled in."
  },
  "peripherals": [
    {
      "id": "rgb_led",
      "kind": "led",
      "part": "WS2812",
      "pins": {
        "data": 8
      }
    },
    {
      "id": "boot_button",
      "kind": "button",
      "pins": {
        "io": 9
      },
      "soft": true
    },
    {
      "id": "usb",
      "kind": "usb",
      "pins": {
        "dm": 12,
        "dp": 13
      }
    }
  ],
  "free_pins": null,
  "software": {
    "arduino_core": null,
    "lvgl": null,
    "esp_idf": null
  },
  "warnings": [
    "USB disconnects below about 4.9V supply. Use a good cable and port."
  ]
}

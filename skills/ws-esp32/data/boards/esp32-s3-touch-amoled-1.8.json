    {"id": "rtc", "kind": "rtc", "part": "PCF85063", "bus": "i2c", "addr": "0x51", "addr_verified": false, "pins": {}},
    {"id": "imu", "kind": "imu", "part": "QMI8658", "bus": "i2c", "addr": null, "pins": {},

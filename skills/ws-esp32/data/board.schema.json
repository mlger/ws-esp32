{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mlger/ws-esp32/skills/ws-esp32/data/board.schema.json",
  "title": "ws-esp32 board profile",
  "type": "object",
  "required": ["id", "name", "chip", "soc", "flash_mb", "psram_mb", "psram_mode", "usb", "verification", "peripherals"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.\\-]*$", "description": "Lowercase product name; must match the file name"},
    "name": {"type": "string", "description": "Exact Waveshare product name"},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "chip": {"enum": ["esp32", "esp32s3", "esp32c3", "esp32c6", "esp32p4"], "description": "Key in data/chips.json"},
    "soc": {"type": "string", "description": "Exact part, e.g. ESP32-S3R8 or ESP32-S3-WROOM-1-N16R8"},
    "flash_mb": {"type": "integer", "minimum": 1},
    "psram_mb": {"type": "integer", "minimum": 0},
    "psram_mode": {"enum": ["none", "quad", "octal", "hex"], "description": "hex = 16-line in-package PSRAM (ESP32-P4)"},
    "chip_revision": {"type": "string", "description": "Key in the chip's revisions map in data/chips.json (ESP32-P4: v1 or v3)"},
    "usb": {
      "type": "object",
      "required": ["native", "console"],
      "properties": {
        "native": {"type": "boolean"},
        "bridge": {"type": ["string", "null"]},
        "console": {"enum": ["uart0", "usb_serial_jtag"]},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["status", "sources"],
      "properties": {
        "status": {"enum": ["partial", "wiki", "schematic", "hardware-tested"]},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}},
        "checked": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "peripherals": {"type": "array", "items": {"$ref": "#/$defs/peripheral"}},
    "free_pins": {"type": ["array", "null"], "items": {"type": "integer"}},
    "not_exposed": {"type": "array", "items": {"type": "integer"}},
    "software": {
      "type": "object",
      "properties": {
        "arduino_core": {"type": ["string", "null"]},
        "lvgl": {"type": ["string", "null"]},
        "esp_idf": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "pin": {
      "description": "GPIO number, 'EXIOn' for an IO-expander pin, or null when unknown",
      "oneOf": [{"type": "integer", "minimum": 0}, {"type": "string", "pattern": "^EXIO\\d+$"}, {"type": "null"}]
    },
    "addr": {"type": ["string", "null"], "pattern": "^0x[0-9A-Fa-f]{2}(-0x[0-9A-Fa-f]{2})?$"},
    "peripheral": {
      "type": "object",
      "required": ["id", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "kind": {"enum": ["bus", "display", "touch", "imu", "rtc", "pmu", "codec", "io_expander", "storage", "led",
                          "button", "adc", "can", "uart", "usb", "camera", "sensor", "ethernet", "wireless"]},
        "part": {"type": "string"},
        "protocol": {"enum": ["i2c", "spi"]},
        "bus": {"type": "string"},
        "interface": {"type": "string"},
        "addr": {"$ref": "#/$defs/addr"},
        "addr_verified": {"type": "boolean"},
        "reserved_addrs": {"type": "array", "items": {"type": "string"}},
        "resolution": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
        "pins": {"type": "object", "additionalProperties": {"$ref": "#/$defs/pin"}},
        "share": {"type": "string"},
        "soft": {"type": "boolean"},
        "notes": {"type": "string"},
        "idf_components": {"type": "array", "items": {"type": "string"}},
        "arduino_libs": {"type": "array", "items": {"type": "string"}},
        "panel_init": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rgb_order": {"enum": ["rgb", "bgr"]},
            "invert": {"type": "boolean"},
            "mirror_x": {"type": "boolean"},
            "mirror_y": {"type": "boolean"},
            "swap_xy": {"type": "boolean"},
            "gap": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
            "pclk_mhz": {"type": "integer"},
            "verified": {"type": "boolean"},
            "source": {"type": "string"}
          }
        },
        "rgb_timing": {
          "type": "object",
          "required": ["pclk_hz", "hsync_pulse_width", "hsync_back_porch", "hsync_front_porch",
                       "vsync_pulse_width", "vsync_back_porch", "vsync_front_porch", "source"],
          "properties": {
            "pclk_hz": {"type": "integer"},
            "hsync_pulse_width": {"type": "integer"},
            "hsync_back_porch": {"type": "integer"},
            "hsync_front_porch": {"type": "integer"},
            "vsync_pulse_width": {"type": "integer"},
            "vsync_back_porch": {"type": "integer"},
            "vsync_front_porch": {"type": "integer"},
            "pclk_active_neg": {"type": "boolean"},
            "bounce_buffer_lines": {"type": "integer"},
            "source": {"type": "string"}
          },
          "additionalProperties": false
        }
      }
    }
  }
}
